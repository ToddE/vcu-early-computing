Program Conversion (input, output, DataFile, OutFile);

var
  length: real;
  max: real;
  normal:real;
  count : integer;
  OutComment: array [1..40] of char;
  InName: array [1..20] of char;
  OutName: array [1..20] of char;
  DataFile, OutFile : text;


  { This program is designed to read in data from an input file.  First}
  { it will traverse the whole file to find the largest maximum absol }
  { ute value.  Once found, all the data is divided by the maximum    }
  { in order to have normalized data.  The data is sent to a user     }
  { input file.                                                       }

  begin
    writeln ('What is the name of the input file?');
    count := 0;
    while (not eoln) and (Count < 20) do  {If more than 20 your array will }
                                           {Overflow }
        begin
             Count := Count + 1;
             read (InName[Count]);
        end;
    readln;
 
    writeln('What is the name of your output file?');
    count := 0;
    while (not eoln) and (Count < 20) do  {If more than 20 your array will }
                                           {Overflow }
        begin
             Count := Count + 1;
             read (OutName[Count]);
        end;
    readln;
    reset (DataFile, InName);
    max:=0;


    repeat
           readln (DataFile, length);
            if max < abs(length) then max:= length;
    until EOF(DataFile);

    reset (DataFile, InName);
    rewrite(OutFile, OutName);

    repeat
            readln(DataFile, length);
             normal:= length/max;
            writeln(OutFile, normal)
    until EOF(DataFile);
end.

