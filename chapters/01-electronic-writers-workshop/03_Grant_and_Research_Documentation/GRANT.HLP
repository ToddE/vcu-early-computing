(* Note.. UNIX pascal is case sensitive so to compile this type: 
   pascal -f (filename).p *)

program RandomNumberDemo (input, output);

var
   seed : integer;   (* Global seed for random number generator *)
   value, min, max : integer;

(* Random number generator by Steve Park and Keith Miller, described in 
   Comm. ACM 31, 10, pp.1192-1201, Oct 1988.
   Returns a Random real value such that 0.0 <= random < 1.0.

   Note: requires a Global integer seed to be initialized to some value 
   between 0 and 2147483647 before calling it the first time. *)

function Random : real;

const
      modulus   =  2147483647;   (* 2^31 -  1 *)
      multiplier = 16807;        (* 7^5 *)
      alpha   = 127773;          (* Modulus div Multiplier *)
      beta    = 2836;            (* modulus mod multiplier *)

var
   high, low, test : integer;

begin
     high := seed div alpha;
     low := seed mod alpha;
     test := multiplier * low - beta * high;
     if test > 0 then
        seed := test
     else
        seed := test + modulus;
     Random := seed / modulus;
end;   (* Function Random *)

begin (* Mainline of demo *)
   seed := 46198;  (* I would advise finding a way to read the system time or
                      or some other method of seeding the random number 
                      generator or you will get the same pattern every time *)

   value := trunc (Random * 100) + 1; (* Choose a number between 1 - 100 *)
   writeln ('A number between 1 - 100: ', value:1);

   min := 3;
   max := 9;
   value := trunc (Random * (max - min + 1)) + min; (* Random # between max 
                                                     and min *)
   writeln ('A number between ', min:1, ' - ', max:1,': ', value:1);
end.

