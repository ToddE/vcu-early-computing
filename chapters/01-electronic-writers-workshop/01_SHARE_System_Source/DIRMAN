if ($#argv == 0) then
        echo "usage: dirman [directory]  "
        exit 1
endif

setenv directory $1 

set var = `who am i | cut -c17-23`

cd $directory
echo "you are now in directory:  $directory"
ls
~/bin/vartest lala
exit
